{
  "mappings": [
    {
      "priority": 10,
      "request": { "method": "POST", "urlPath": "/provider/v1/activate" },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 300,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "activationId": "{{randomValue type='UUID'}}", "status": "ACTIVATED" }
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode == 'INVALID')]" }]
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "unknown product" }
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode == 'ERROR')]" }]
      },
      "response": { "status": 500 }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode == 'SLOW')]" }]
      },
      "response": { "status": 200, "fixedDelayMilliseconds": 10000 }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode == 'BUSY')]" }]
      },
      "response": { "status": 503, "headers": { "Retry-After": "10" } }
    }
  ]
}
